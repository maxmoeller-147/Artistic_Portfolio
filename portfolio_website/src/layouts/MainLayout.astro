---
import Header from "@/components/layout/Header.astro";
import SiteBackground from "@/components/layout/SiteBackground.astro";
import { siteConfig } from "@/config/site";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = siteConfig.title,
  description = siteConfig.description,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-portfolio-bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Theme bootstrapping runs before CSS paints to avoid a theme flash. -->
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("theme");
          const systemTheme = window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";

          document.documentElement.dataset.theme = savedTheme || systemTheme;
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="relative min-h-full bg-portfolio-bg font-portfolio leading-[1.6] text-portfolio-text transition-[background-color,color] duration-200 before:pointer-events-none before:fixed before:inset-0 before:z-0 before:bg-[image:var(--page-background-image)] before:bg-center before:bg-cover before:bg-no-repeat before:opacity-[var(--page-background-opacity)] before:content-['']">
    <SiteBackground />
    <Header />
    <slot />
  </body>
</html>
