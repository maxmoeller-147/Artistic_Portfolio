---
type Props = {
  href: string;
  label: string;
  variant?: "primary" | "secondary";
  className?: string;
  ariaLabel?: string;
  target?: string;
  rel?: string;
};

const {
  href,
  label,
  variant = "primary",
  className = "",
  ariaLabel,
  target,
  rel,
} = Astro.props;

const buttonClass = ["button", `button--${variant}`, className]
  .filter(Boolean)
  .join(" ");
---

<a
  href={href}
  class={buttonClass}
  aria-label={ariaLabel}
  target={target}
  rel={rel}
>
  {label}
</a>
