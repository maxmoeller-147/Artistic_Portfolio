---
import type { LinkItem } from "@/types/content";

type Props = {
  links: LinkItem[];
  listClass: string;
  linkClass: string;
};

const { links, listClass, linkClass } = Astro.props;
---

<ul class={listClass}>
  {links.map((link) => (
    <li>
      <a href={link.href} class={linkClass}>{link.label}</a>
    </li>
  ))}
</ul>
