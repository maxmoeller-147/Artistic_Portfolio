---
import NavigationList from "@/components/common/NavigationList.astro";
import MobileMenuButton from "@/components/layout/MobileMenuButton.astro";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";
import { navLinks, profile } from "@/data";

const headerContainerClass =
  "mx-auto flex min-h-[4.5rem] w-[calc(100%_-_2rem)] max-w-[var(--max-width)] items-center justify-between gap-4";
const navListClass = "m-0 flex list-none items-center gap-[0.35rem] p-0";
const navLinkClass =
  "inline-flex h-10 items-center justify-center rounded-none px-[0.9rem] font-medium text-portfolio-muted no-underline transition-[background-color,color] duration-200 hover:bg-portfolio-surface hover:text-portfolio-text";
const mobileNavListClass = "m-0 flex list-none flex-col p-0";
const mobileNavLinkClass =
  "block border-b border-portfolio-border px-6 py-4 font-medium text-portfolio-text no-underline transition-colors duration-200 hover:bg-portfolio-surface";
const contactClass =
  "inline-flex h-10 min-w-[6.5rem] items-center justify-center rounded-none border border-portfolio-border bg-portfolio-surface px-4 font-semibold text-portfolio-text no-underline transition-[border-color,background-color,color,transform] duration-200 hover:-translate-y-px hover:border-portfolio-primary hover:bg-portfolio-surface-strong hover:text-portfolio-primary max-[768px]:hidden";
---

<header class="sticky top-0 z-[1000] border-b border-portfolio-border bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] backdrop-blur-[14px]">
  <div class={headerContainerClass}>
    <a
      href="#top"
      class="inline-flex shrink-0 items-center font-bold text-portfolio-text no-underline"
      aria-label="Go to top of page"
    >
      <span class="leading-none">{profile.name}</span>
    </a>

    <nav class="hidden min-[769px]:block" aria-label="Main navigation">
      <NavigationList
        links={navLinks}
        listClass={navListClass}
        linkClass={navLinkClass}
      />
    </nav>

    <div class="flex items-center gap-[0.65rem]">
      <ThemeToggle />

      <a
        href={`mailto:${profile.email}`}
        class={contactClass}
        aria-label="Send email"
      >
        Contact
      </a>

      <MobileMenuButton />
    </div>
  </div>

  <nav
    class="mobile-nav invisible absolute inset-x-0 top-full -translate-y-full border-b border-portfolio-border bg-portfolio-bg opacity-0 transition-[transform,opacity,visibility] duration-300 [&.open]:visible [&.open]:translate-y-0 [&.open]:opacity-100"
    aria-hidden="true"
  >
    <NavigationList
      links={navLinks}
      listClass={mobileNavListClass}
      linkClass={`mobile-nav-link ${mobileNavLinkClass}`}
    />
  </nav>
</header>

<script>
  const hamburgerButton = document.querySelector('.hamburger-button');
  const mobileNav = document.querySelector('.mobile-nav');

  const setMobileMenu = (isOpen) => {
    hamburgerButton?.setAttribute('aria-expanded', String(isOpen));
    mobileNav?.setAttribute('aria-hidden', String(!isOpen));
    mobileNav?.classList.toggle('open', isOpen);
  };

  hamburgerButton?.addEventListener('click', () => {
    const isExpanded = hamburgerButton.getAttribute('aria-expanded') === 'true';
    setMobileMenu(!isExpanded);
  });

  // Close the mobile menu after navigation to avoid leaving the overlay open.
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => setMobileMenu(false));
  });

  const themeToggle = document.querySelector('.theme-toggle');
  const sunIcon = themeToggle?.querySelector('.sun-icon');
  const moonIcon = themeToggle?.querySelector('.moon-icon');
  const root = document.documentElement;

  const setTheme = (theme) => {
    const nextTheme = theme === 'light' ? 'light' : 'dark';

    root.dataset.theme = nextTheme;
    themeToggle?.setAttribute(
      'aria-label',
      nextTheme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
    );
    themeToggle?.setAttribute('aria-pressed', String(nextTheme === 'light'));
    sunIcon?.classList.toggle('opacity-0', nextTheme === 'light');
    sunIcon?.classList.toggle('opacity-100', nextTheme !== 'light');
    moonIcon?.classList.toggle('opacity-0', nextTheme !== 'light');
    moonIcon?.classList.toggle('opacity-100', nextTheme === 'light');

    try {
      localStorage.setItem('theme', nextTheme);
    } catch {
      // Theme still changes for this session if storage is unavailable.
    }
  };

  setTheme(root.dataset.theme);

  themeToggle?.addEventListener('click', () => {
    setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
  });
</script>
