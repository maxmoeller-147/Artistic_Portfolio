---
import type { ExperienceItem } from "@/types/content";
import ExperienceCard from "@/components/cards/ExperienceCard.astro";
import Section from "@/components/common/Section.astro";
import { sectionContent } from "@/data";

type Props = {
  experienceItems: ExperienceItem[];
};

const { experienceItems } = Astro.props;
const { experience } = sectionContent;
---

<Section id={experience.id} label={experience.label} title={experience.title}>
  <div class="grid gap-6">
    {experienceItems.map((item) => (
      <ExperienceCard item={item} />
    ))}
  </div>
</Section>
