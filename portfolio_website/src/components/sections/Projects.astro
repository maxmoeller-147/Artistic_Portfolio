---
import type { Project } from "../../types/content";
import SectionHeading from "../ui/SectionHeading.astro";
import ProjectCard from "../ui/ProjectCard.astro";

type Props = {
  projects: Project[];
};

const { projects } = Astro.props;
---

<!-- Projects: horizontally scrollable list of reusable project cards. -->
<section id="projects" class="section-block section-block--spacious">
  <SectionHeading
    label="Projects"
    title="Things I've built and worked on"
  />

  <!-- The list wrapper keeps project cards semantic and scroll-snapped. -->
  <div class="projects-carousel">
    <ul class="projects-grid" id="projectsCarousel" role="list">
      {projects.map((project) => (
        <li class="projects-item">
          <ProjectCard project={project} />
        </li>
      ))}
    </ul>
  </div>
</section>
