---
import type { Project } from "@/types/content";
import ProjectCard from "@/components/cards/ProjectCard.astro";
import Section from "@/components/common/Section.astro";
import { sectionContent } from "@/data";

type Props = {
  projects: Project[];
};

const { projects } = Astro.props;
const { projects: copy } = sectionContent;
---

<Section id={copy.id} label={copy.label} title={copy.title} spacious>
  <div class="flex items-center gap-2 overflow-hidden min-[769px]:gap-4">
    <ul
      class="m-0 flex list-none gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 pl-2 pr-2 [-webkit-overflow-scrolling:touch] [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-portfolio-scrollbar [&::-webkit-scrollbar]:h-2.5"
      id="projectsCarousel"
      role="list"
    >
      {projects.map((project) => (
        <li class="snap-start flex-[0_0_min(360px,90%)] [&>article]:h-full">
          <ProjectCard project={project} />
        </li>
      ))}
    </ul>
  </div>
</Section>
