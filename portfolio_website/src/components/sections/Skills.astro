---
import type { SkillCategory } from "@/types/content";
import SkillCard from "@/components/cards/SkillCard.astro";
import Section from "@/components/common/Section.astro";
import { sectionContent } from "@/data";

type Props = {
  skillCategories: SkillCategory[];
};

const { skillCategories } = Astro.props;
const { skills } = sectionContent;
---

<Section id={skills.id} label={skills.label} title={skills.title}>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {skillCategories.map((category) => (
      <SkillCard category={category} />
    ))}
  </div>
</Section>
