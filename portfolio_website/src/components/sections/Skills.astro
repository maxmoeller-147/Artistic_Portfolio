---
import type { SkillCategory } from "../../types/content";
import SectionHeading from "../ui/SectionHeading.astro";

type Props = {
  skillCategories: SkillCategory[];
};

const { skillCategories } = Astro.props;
---

<!-- Skills: grouped technical abilities from the skills data file. -->
<section id="skills" class="section-block">
  <SectionHeading
    label="Skills"
    title="Tools and technologies I use"
  />

  <div class="skills-grid">
    {skillCategories.map((category) => (
      <article class="surface-card">
        <h3 class="skills-card-title">{category.title}</h3>

        <ul class="tag-list">
          {category.items.map((item) => (
            <li class="tag">{item}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
