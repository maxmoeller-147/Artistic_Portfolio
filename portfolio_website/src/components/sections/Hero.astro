---
import type { Profile } from "@/types/content";
import ActionRow from "@/components/common/ActionRow.astro";
import Button from "@/components/common/Button.astro";
import Section from "@/components/common/Section.astro";
import { sectionContent } from "@/data";

type Props = {
  profile: Profile;
};

const { profile } = Astro.props;
const { hero } = sectionContent;
---

<Section id={hero.id}>
  <p class="mb-2 font-semibold text-portfolio-primary">{profile.role}</p>
  <h1 class="mb-4 text-[2.5rem] leading-[1.1] text-portfolio-text sm:text-6xl lg:text-[4.5rem]">
    {profile.name}
  </h1>
  <p class="mb-4 max-w-[700px] text-xl text-portfolio-text">{profile.tagline}</p>
  <p class="mb-4 max-w-[700px] text-portfolio-muted">{profile.summary}</p>

  <ActionRow className="mt-6">
    <Button
      href={hero.actions.projects.href}
      label={hero.actions.projects.label}
      variant="primary"
    />
    <Button
      href={hero.actions.contact.href}
      label={hero.actions.contact.label}
      variant="secondary"
    />
  </ActionRow>
</Section>
