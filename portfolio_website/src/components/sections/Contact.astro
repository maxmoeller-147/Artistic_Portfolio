---
import type { Profile } from "@/types/content";
import ActionRow from "@/components/common/ActionRow.astro";
import Button from "@/components/common/Button.astro";
import Section from "@/components/common/Section.astro";
import { sectionContent } from "@/data";

type Props = {
  profile: Profile;
};

const { profile } = Astro.props;
const { contact } = sectionContent;
---

<Section id={contact.id} label={contact.label} title={contact.title}>
  <p class="section-copy contact-text">{contact.intro}</p>

  <div class="contact-details">
    <p class="contact-item">
      <span class="contact-label">Email:</span>
      <a href={`mailto:${profile.email}`} class="contact-link">
        {profile.email}
      </a>
    </p>

    <p class="contact-item">
      <span class="contact-label">Location:</span>
      {profile.location}
    </p>
  </div>

  <ActionRow className="contact-actions">
    <Button
      href={`mailto:${profile.email}`}
      label="Send Email"
      variant="primary"
    />
  </ActionRow>

  <ul class="social-links">
    {profile.socials.map((social) => (
      <li>
        <a href={social.href} class="social-link" target="_blank" rel="noreferrer">
          {social.label}
        </a>
      </li>
    ))}
  </ul>
</Section>
