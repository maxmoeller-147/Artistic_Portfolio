---
import type { Profile } from "@/types/content";
import ActionRow from "@/components/common/ActionRow.astro";
import Button from "@/components/common/Button.astro";
import Section from "@/components/common/Section.astro";
import { sectionContent } from "@/data";

type Props = {
  profile: Profile;
};

const { profile } = Astro.props;
const { contact } = sectionContent;
---

<Section id={contact.id} label={contact.label} title={contact.title}>
  <p class="mb-6 max-w-[700px] text-portfolio-muted">{contact.intro}</p>

  <div class="mb-6 grid gap-2">
    <p class="mb-4 text-portfolio-text">
      <span class="mr-[0.35rem] font-semibold">Email:</span>
      <a href={`mailto:${profile.email}`} class="text-portfolio-primary no-underline hover:underline">
        {profile.email}
      </a>
    </p>

    <p class="mb-4 text-portfolio-text">
      <span class="mr-[0.35rem] font-semibold">Location:</span>
      {profile.location}
    </p>
  </div>

  <ActionRow className="mb-6">
    <Button
      href={`mailto:${profile.email}`}
      label="Send Email"
      variant="primary"
    />
  </ActionRow>

  <ul class="m-0 flex list-none flex-wrap gap-4 p-0">
    {profile.socials.map((social) => (
      <li>
        <a
          href={social.href}
          class="font-medium text-portfolio-text no-underline hover:text-portfolio-primary"
          target="_blank"
          rel="noreferrer"
        >
          {social.label}
        </a>
      </li>
    ))}
  </ul>
</Section>
