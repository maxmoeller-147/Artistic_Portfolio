---
import type { Profile } from "@/types/content";
import Section from "@/components/common/Section.astro";
import { sectionContent } from "@/data";

type Props = {
  profile: Profile;
};

const { profile } = Astro.props;
const { about } = sectionContent;
---

<Section id={about.id} label={about.label} title={about.title}>
  <p class="mb-4 max-w-[750px] text-[1.05rem] text-portfolio-muted">{profile.about}</p>
</Section>
