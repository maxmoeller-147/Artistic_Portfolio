---
import type { Profile } from "@/types/content";
import Section from "@/components/common/Section.astro";
import { sectionContent } from "@/data";

type Props = {
  profile: Profile;
};

const { profile } = Astro.props;
const { about } = sectionContent;
---

<Section id={about.id} label={about.label} title={about.title}>
  <p class="section-copy about-text">{profile.about}</p>
</Section>
