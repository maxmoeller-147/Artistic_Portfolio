---
import type { SkillCategory } from "@/types/content";
import TagList from "@/components/common/TagList.astro";

type Props = {
  category: SkillCategory;
};

const { category } = Astro.props;
---

<article class="rounded-none border border-portfolio-border bg-portfolio-surface p-6">
  <h3 class="mb-4 text-[1.1rem] text-portfolio-text">{category.title}</h3>
  <TagList items={category.items} />
</article>
