---
import type { ExperienceItem } from "@/types/content";

type Props = {
  item: ExperienceItem;
};

const { item } = Astro.props;
---

<article class="border-l-[3px] border-portfolio-primary pl-6">
  <p class="mb-2 font-semibold text-portfolio-primary">{item.period}</p>
  <h3 class="mb-[0.35rem] text-[1.2rem] text-portfolio-text">{item.role}</h3>
  <p class="mb-2 font-medium text-portfolio-text">{item.company}</p>
  <p class="mb-4 max-w-[720px] text-portfolio-muted">{item.description}</p>
</article>
